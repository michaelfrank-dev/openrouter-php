{
    "name": "michaelfrank-dev/openrouter-php",
    "description": "Unofficial, PSR-compliant PHP SDK for the OpenRouter API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "openrouter",
        "ai",
        "llm",
        "sdk",
        "api-client",
        "openai",
        "claude",
        "gemini",
        "streaming",
        "psr-18",
        "psr-17"
    ],
    "homepage": "https://github.com/michaelfrank-dev/openrouter-php",
    "readme": "README.md",
    "authors": [
        {
            "name": "Michael Frank",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/michaelfrank-dev/openrouter-php/issues",
        "source": "https://github.com/michaelfrank-dev/openrouter-php"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0||^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5||^11.0",
        "phpstan/phpstan": "^1.10",
        "vimeo/psalm": "^6.0",
        "squizlabs/php_codesniffer": "^4.0.2",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "MichaelFrank\\OpenRouter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MichaelFrank\\OpenRouter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "check": ["@cs", "@stan", "@psalm", "@test"],
        "cs": "phpcs",
        "csf": "phpcbf",
        "stan": "phpstan analyse",
        "psalm": "psalm",
        "test": "phpunit"
    }
}
